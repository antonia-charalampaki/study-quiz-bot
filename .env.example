# Αντέγραψε αυτό το αρχείο σε ένα νέο με όνομα .env και βάλε το δικό σου κλειδί.
# ΜΗΝ ανεβάσεις ποτέ το .env στο GitHub!
GEMINI_API_KEY=βάλε-εδώ-το-κλειδί-σου
GEMINI_MODEL=gemini-3.8-flash
# Προαιρετικό: εφεδρικά μοντέλα αν το πρώτο είναι φορτωμένο, χωρισμένα με κόμμα.
# Αν το αφήσεις κενό, το bot τα βρίσκει μόνο του. Δες τη λίστα με: python list_models.py
# GEMINI_FALLBACK_MODEL=gemini-3.7-flash,gemini-3.5-flash-lite
