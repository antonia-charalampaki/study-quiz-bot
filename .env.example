# Αντέγραψε αυτό το αρχείο σε ένα νέο με όνομα .env και συμπλήρωσε τις τιμές.
# ΜΗΝ ανεβάσεις ποτέ το .env στο GitHub!

# ---- Ποιο LLM θα απαντά ----
# gemini         = μόνο Google Gemini (cloud, θέλει API key)
# ollama         = μόνο τοπικό ανοιχτό μοντέλο (δωρεάν, θέλει την εφαρμογή Ollama)
# gemini,ollama  = πρώτα Gemini, κι αν αποτύχει, τοπικό μοντέλο
LLM_PROVIDER=gemini,ollama

# ---- Gemini ----
GEMINI_API_KEY=βάλε-εδώ-το-κλειδί-σου
GEMINI_MODEL=gemini-3.8-flash
# Προαιρετικό: εφεδρικά μοντέλα Gemini, χωρισμένα με κόμμα. Κενό = τα βρίσκει μόνο του.
# GEMINI_FALLBACK_MODEL=gemini-3.7-flash,gemini-3.5-flash-lite

# ---- Ollama (τοπικό μοντέλο) ----
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384

# ---- Μόνο για το online demo ----
# STUDYBOT_STORAGE=session     πρόοδος ανά επισκέπτη, όχι σε κοινό αρχείο
# APP_PASSWORD=...             κωδικός για να μπει κάποιος στην εφαρμογή
